<Window x:Class="GroupProject.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GroupProject"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <DockPanel>
        <StackPanel Margin="24">
            <TextBlock Text="Регистрация"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,16"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginTextBox" Margin="0,4,0,10"/>

            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10"/>

            <TextBlock Text="Фамилия"/>
            <TextBox x:Name="LastNameTextBox" Margin="0,4,0,10"/>

            <TextBlock Text="Имя"/>
            <TextBox x:Name="FirstNameTextBox" Margin="0,4,0,10"/>

            <TextBlock Text="Отчество"/>
            <TextBox x:Name="PatronymicTextBox" Margin="0,4,0,16"/>

            <Button x:Name="RegistrationButton" Content="Зарегистрироваться"
                Height="34" Click="RegistrationButton_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
