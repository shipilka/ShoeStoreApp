<Window x:Class="GroupProject.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GroupProject"
        mc:Ignorable="d"
        Title="Authorization" Height="450" Width="800">
    <DockPanel>
        <StackPanel Margin="24">
            <TextBlock Text="Вход"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,16"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginTextBox" Margin="0,4,0,10"/>

            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16"/>

            <Button x:Name="AuthorizationButton" Content="Войти" Height="34"
                Click="AuthorizationButton_Click"/>

            <Button x:Name="OpenRegistrationButton" Content="Зарегистрироваться" Height="34"
                Margin="0,8,0,0"
                Click="OpenRegistrationButton_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
